{
  "name": "edgedir",
  "displayName": "EDGEdir: Cyberpunk 2077 Animation Director",
  "description": "A director's tool for the video game Cyberpunk 2077: design and stitch animations and acting sequences for the game's characters, and play them in the running game. A game modding tool.",
  "version": "0.0.1",
  "publisher": "edgemodders",
  "preview": true,
  "pricing": "Free",
  "license": "MIT",
  "icon": "docs/assets/brand/icon.png",
  "galleryBanner": {
    "color": "#08090d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Edgemodders/EDGEdir"
  },
  "homepage": "https://edgemodders.github.io/EDGEdir/",
  "bugs": {
    "url": "https://github.com/Edgemodders/EDGEdir/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cyberpunk 2077",
    "video game",
    "game modding",
    "animation",
    "workspot",
    "npc",
    "director",
    "edgedir"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "edgedir",
          "title": "EDGEdir",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "edgedir": [
        {
          "id": "edgedir.desk",
          "name": "Desk"
        },
        {
          "id": "edgedir.library",
          "name": "Library"
        },
        {
          "id": "edgedir.animations",
          "name": "Animations"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "edgedir.desk",
        "contents": "Sequences you are working on will wait here until they go into a project. EDGEdir is being designed.\n[About EDGEdir](https://edgemodders.github.io/EDGEdir/)"
      },
      {
        "view": "edgedir.library",
        "contents": "Sequences you keep for good will wait here, in the EDGE Library: one folder of your own that every EDGE tool shares.\n[About the EDGE Library](https://edgemodders.ai/wiki/library.html)"
      },
      {
        "view": "edgedir.animations",
        "contents": "The game's animations and workspots will be listed here. EDGEdir is being designed."
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node esbuild.mjs --tests && node --test \"dist-test/*.test.cjs\"",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies --readme-path README.marketplace.md",
    "nexus-zip": "node tools/nexus-zip.mjs",
    "nexus:pull": "node ../EDGErepo/tools/nexus/nexus.mjs pull",
    "nexus:status": "node ../EDGErepo/tools/nexus/nexus.mjs status",
    "release:notes": "node tools/release-notes.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "typescript": "~5.9.3"
  }
}
