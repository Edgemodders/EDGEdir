{
  "name": "edgedir",
  "displayName": "EDGEdir: Cyberpunk 2077 Animation Director",
  "description": "A director's tool for the video game Cyberpunk 2077: design and stitch animations and acting sequences for the game's characters, and play them in the running game. A game modding tool.",
  "version": "0.0.14",
  "publisher": "edgemodders",
  "preview": true,
  "pricing": "Free",
  "license": "MIT",
  "icon": "docs/assets/brand/icon.png",
  "galleryBanner": {
    "color": "#08090d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Edgemodders/EDGEdir"
  },
  "homepage": "https://edgemodders.github.io/EDGEdir/",
  "bugs": {
    "url": "https://github.com/Edgemodders/EDGEdir/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cyberpunk 2077",
    "video game",
    "game modding",
    "animation",
    "workspot",
    "npc",
    "director",
    "edgedir"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "edgedir",
          "title": "EDGEdir",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "edgedir": [
        {
          "id": "edgedir.desk",
          "name": "Desk"
        },
        {
          "id": "edgedir.library",
          "name": "Library"
        },
        {
          "id": "edgedir.animations",
          "name": "Animations"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "edgedir.desk",
        "contents": "Scenes you are working on wait here until they go into a project or the Library.\n[New Scene](command:edgedir.newScene)\n[About EDGEdir](https://edgemodders.github.io/EDGEdir/)"
      },
      {
        "view": "edgedir.library",
        "contents": "Scenes and sequences you keep for good will wait here, in the EDGE Library: one folder of your own that every EDGE tool shares. Not built yet.\n[About the EDGE Library](https://edgemodders.ai/wiki/library.html)"
      },
      {
        "view": "edgedir.animations",
        "when": "edgedir.state == starting",
        "contents": "The game's animations are listed here, to put on a character's track. EDGEdir reads them from your game through REDbridge and keeps the list on this PC.\n[Read the Game](command:edgedir.readGame)"
      },
      {
        "view": "edgedir.animations",
        "when": "edgedir.state == loading",
        "contents": "Reading the game..."
      },
      {
        "view": "edgedir.animations",
        "when": "edgedir.state == noGame",
        "contents": "No Cyberpunk 2077 folder was found.\n[Set the Game Folder](command:workbench.action.openSettings?%22edgedir.gamePath%22)\n[Try Again](command:edgedir.readGame)"
      },
      {
        "view": "edgedir.animations",
        "when": "edgedir.state == noBridge",
        "contents": "REDbridge was not found. EDGEdir reads the game's files through it. It comes with REDcode, or set where it is.\n[Set REDbridge's Path](command:workbench.action.openSettings?%22edgedir.bridgePath%22)\n[Try Again](command:edgedir.readGame)"
      },
      {
        "view": "edgedir.animations",
        "when": "edgedir.state == failed",
        "contents": "The game could not be read.\n[Show Log](command:edgedir.showLog)\n[Try Again](command:edgedir.readGame)"
      }
    ],
    "customEditors": [
      {
        "viewType": "edgedir.scene",
        "displayName": "EDGEdir Scene Editor",
        "selector": [
          {
            "filenamePattern": "*.edgedir"
          },
          {
            "filenamePattern": "*.edgeseq"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "json",
        "extensions": [
          ".edgedir",
          ".edgeseq"
        ]
      }
    ],
    "commands": [
      {
        "command": "edgedir.newScene",
        "title": "New Scene",
        "category": "EDGEdir",
        "icon": "$(add)"
      },
      {
        "command": "edgedir.newSequence",
        "title": "New Sequence",
        "category": "EDGEdir",
        "icon": "$(list-ordered)"
      },
      {
        "command": "edgedir.addSequenceToTrack",
        "title": "Add to Track",
        "category": "EDGEdir",
        "icon": "$(add)"
      },
      {
        "command": "edgedir.refreshDesk",
        "title": "Refresh the Desk",
        "category": "EDGEdir",
        "icon": "$(refresh)"
      },
      {
        "command": "edgedir.openScene",
        "title": "Open Scene",
        "category": "EDGEdir"
      },
      {
        "command": "edgedir.renameScene",
        "title": "Rename...",
        "category": "EDGEdir"
      },
      {
        "command": "edgedir.deleteScene",
        "title": "Delete",
        "category": "EDGEdir"
      },
      {
        "command": "edgedir.revealScene",
        "title": "Reveal in File Explorer",
        "category": "EDGEdir"
      },
      {
        "command": "edgedir.forgetRecent",
        "title": "Remove from Recent",
        "category": "EDGEdir"
      },
      {
        "command": "edgedir.readGame",
        "title": "Read the Game",
        "category": "EDGEdir",
        "icon": "$(refresh)"
      },
      {
        "command": "edgedir.readGameAgain",
        "title": "Read the Game Again",
        "category": "EDGEdir",
        "icon": "$(refresh)"
      },
      {
        "command": "edgedir.showLog",
        "title": "Show Log",
        "category": "EDGEdir"
      },
      {
        "command": "edgedir.searchAnimations",
        "title": "Search Animations...",
        "category": "EDGEdir",
        "icon": "$(search)"
      },
      {
        "command": "edgedir.clearAnimationSearch",
        "title": "Clear the Search",
        "category": "EDGEdir",
        "icon": "$(clear-all)"
      },
      {
        "command": "edgedir.copyAnimPath",
        "title": "Copy Path",
        "category": "EDGEdir"
      },
      {
        "command": "edgedir.addToTrack",
        "title": "Add to Track",
        "category": "EDGEdir",
        "icon": "$(add)"
      },
      {
        "command": "edgedir.copyAnimName",
        "title": "Copy Animation Name",
        "category": "EDGEdir"
      },
      {
        "command": "edgedir.animFitsOn",
        "title": "Only What Fits the Selected Actor",
        "category": "EDGEdir",
        "icon": "$(person)"
      },
      {
        "command": "edgedir.animFitsOff",
        "title": "Only What Fits the Selected Actor (On)",
        "category": "EDGEdir",
        "icon": "$(person-add)"
      },
      {
        "command": "edgedir.animCarriedOn",
        "title": "Only the Selected Actor's Own Files",
        "category": "EDGEdir"
      },
      {
        "command": "edgedir.animCarriedOff",
        "title": "✓ Only the Selected Actor's Own Files",
        "category": "EDGEdir"
      },
      {
        "command": "edgedir.refreshAnimations",
        "title": "Refresh",
        "category": "EDGEdir",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "edgedir.newScene",
          "when": "view == edgedir.desk",
          "group": "navigation@1"
        },
        {
          "command": "edgedir.newSequence",
          "when": "view == edgedir.desk",
          "group": "navigation@2"
        },
        {
          "command": "edgedir.refreshDesk",
          "when": "view == edgedir.desk",
          "group": "navigation@3"
        },
        {
          "command": "edgedir.searchAnimations",
          "when": "view == edgedir.animations && edgedir.state == ready",
          "group": "navigation@1"
        },
        {
          "command": "edgedir.clearAnimationSearch",
          "when": "view == edgedir.animations && edgedir.animSearch",
          "group": "navigation@2"
        },
        {
          "command": "edgedir.readGameAgain",
          "when": "view == edgedir.animations && edgedir.state != loading",
          "group": "overflow@1"
        },
        {
          "command": "edgedir.showLog",
          "when": "view == edgedir.animations",
          "group": "overflow@2"
        },
        {
          "command": "edgedir.animFitsOn",
          "when": "view == edgedir.animations && edgedir.state == ready && !edgedir.animFits",
          "group": "navigation@3"
        },
        {
          "command": "edgedir.animFitsOff",
          "when": "view == edgedir.animations && edgedir.state == ready && edgedir.animFits",
          "group": "navigation@3"
        },
        {
          "command": "edgedir.animCarriedOn",
          "when": "view == edgedir.animations && edgedir.state == ready && !edgedir.animCarried",
          "group": "filter@1"
        },
        {
          "command": "edgedir.animCarriedOff",
          "when": "view == edgedir.animations && edgedir.state == ready && edgedir.animCarried",
          "group": "filter@1"
        },
        {
          "command": "edgedir.refreshAnimations",
          "when": "view == edgedir.animations",
          "group": "navigation@4"
        },
        {
          "command": "edgedir.readGame",
          "when": "view == edgedir.animations && edgedir.state != ready && edgedir.state != loading",
          "group": "overflow@0"
        }
      ],
      "view/item/context": [
        {
          "command": "edgedir.addSequenceToTrack",
          "when": "view == edgedir.desk && viewItem == deskSequence",
          "group": "inline"
        },
        {
          "command": "edgedir.addSequenceToTrack",
          "when": "view == edgedir.desk && viewItem == deskSequence",
          "group": "0@1"
        },
        {
          "command": "edgedir.renameScene",
          "when": "view == edgedir.desk && viewItem =~ /^desk(Scene|Sequence)$/",
          "group": "1@1"
        },
        {
          "command": "edgedir.revealScene",
          "when": "view == edgedir.desk && viewItem =~ /(Scene|Sequence)$/",
          "group": "1@2"
        },
        {
          "command": "edgedir.deleteScene",
          "when": "view == edgedir.desk && viewItem =~ /^desk(Scene|Sequence)$/",
          "group": "2@1"
        },
        {
          "command": "edgedir.forgetRecent",
          "when": "view == edgedir.desk && viewItem == recentScene",
          "group": "2@1"
        },
        {
          "command": "edgedir.copyAnimPath",
          "when": "view == edgedir.animations && (viewItem == animSet || viewItem == animClip)",
          "group": "copy@2"
        },
        {
          "command": "edgedir.addToTrack",
          "when": "view == edgedir.animations && viewItem == animClip",
          "group": "inline"
        },
        {
          "command": "edgedir.addToTrack",
          "when": "view == edgedir.animations && viewItem == animClip",
          "group": "add@1"
        },
        {
          "command": "edgedir.copyAnimName",
          "when": "view == edgedir.animations && viewItem == animClip",
          "group": "copy@1"
        }
      ],
      "commandPalette": [
        {
          "command": "edgedir.openScene",
          "when": "false"
        },
        {
          "command": "edgedir.renameScene",
          "when": "false"
        },
        {
          "command": "edgedir.deleteScene",
          "when": "false"
        },
        {
          "command": "edgedir.revealScene",
          "when": "false"
        },
        {
          "command": "edgedir.forgetRecent",
          "when": "false"
        },
        {
          "command": "edgedir.copyAnimPath",
          "when": "false"
        },
        {
          "command": "edgedir.clearAnimationSearch",
          "when": "edgedir.animSearch"
        },
        {
          "command": "edgedir.addToTrack",
          "when": "false"
        },
        {
          "command": "edgedir.copyAnimName",
          "when": "false"
        },
        {
          "command": "edgedir.animFitsOff",
          "when": "false"
        },
        {
          "command": "edgedir.animCarriedOff",
          "when": "false"
        },
        {
          "command": "edgedir.addSequenceToTrack",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "EDGEdir",
      "properties": {
        "edgedir.gamePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "The Cyberpunk 2077 folder. Leave empty to use REDcode's or EDGEdeck's, or to let EDGEdir look for the game.",
          "scope": "machine"
        },
        "edgedir.bridgePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "`REDbridge.exe`, or its folder. Leave empty to use REDcode's. EDGEdir reads the game's characters and animations through REDbridge.",
          "scope": "machine"
        },
        "edgedir.dotnetRoot": {
          "type": "string",
          "default": "",
          "markdownDescription": "The folder of a .NET runtime installed for one user, for REDbridge. Leave empty to use REDcode's setting or the system's .NET.",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node esbuild.mjs --tests && node --test \"dist-test/*.test.cjs\"",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies --readme-path README.marketplace.md",
    "nexus-zip": "node tools/nexus-zip.mjs",
    "nexus:pull": "node ../EDGErepo/tools/nexus/nexus.mjs pull",
    "nexus:status": "node ../EDGErepo/tools/nexus/nexus.mjs status",
    "release:notes": "node tools/release-notes.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.170.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "three": "^0.170.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "vscode-jsonrpc": "^9.0.3"
  }
}
